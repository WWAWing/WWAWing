{
  "name": "@wwawing/wwawing",
  "version": "0.0.0",
  "description": "",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "test": "pnpm --filter @wwawing/engine --filter serve-index test",
    "clean": "pnpm -r run clean",
    "start": "pnpm -C packages/engine start",
    "build": "pnpm -r run build",
    "deploy": "pnpm --filter @wwawing/engine deploy:prod",
    "generate": "pnpm -r run generate",
    "make-dist": "pnpm run build && pnpm -r run make-dist",
    "version-up": "pnpm --filter \"./packages/*\" version",
    "publish:all": "run-s build generate && pnpm -r publish --workspace-concurrency=1 --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WWAWing/WWAWing.git"
  },
  "keywords": [
    "WWA"
  ],
  "author": "WWA Wing Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/WWAWing/WWAWing/issues"
  },
  "homepage": "https://github.com/WWAWing/WWAWing#readme",
  "devDependencies": {
    "@swc/core": "^1.10.4",
    "@swc/helpers": "^0.5.15",
    "@types/node": "^26",
    "npm-run-all2": "^8.0.1",
    "regenerator-runtime": "^0.14.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=26",
    "npm": "使えない",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.14.0"
}
