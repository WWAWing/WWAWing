    "@wwawing/common-interface": "workspace:*",
    "@wwawing/debug-server": "4.0.2",
    "@wwawing/engine": "workspace:*",
    "@wwawing/loader": "workspace:*",
    "@wwawing/page-generator": "workspace:*",
    "@wwawing/serve-index": "4.0.2",
    "@wwawing/styles": "workspace:*",
    "jszip": "^3.10.1",
    "npm-run-all2": "^8.0.1",
    "shelljs": "^0.10.0",
    "shx": "^0.4.0",
