{
  "name": "@wwawing/engine",
  "version": "3.12.33",
  "description": "World Wide Adventure: an RPG Engine.",
  "main": "./lib/wwa.js",
  "files": [
    "debug",
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "jest",
    "start": "run-p build:dev deploy:dev server",
    "build": "run-s clean build:prod",
    "build:prod": "webpack --config webpack.config.prod.ts",
    "build:dev": "webpack -w",
    "deploy:prod": "shx mkdir -p lib && run-p deploy:common:* deploy:prod:*",
    "deploy:dev": "shx mkdir -p lib && run-p deploy:common:* deploy:dev:*",
    "deploy:common:audio": "shx cp -R ../assets/audio lib/",
    "deploy:common:images": "shx cp ../assets/images/*.* lib/",
    "deploy:common:mapdata": "shx cp ../assets/mapdata/*.* lib/",
    "deploy:common:vars": "shx cp ../assets/vars/*.* lib/",
    "deploy:common:style": "shx cp ../styles/output/*.* lib/ && shx cp ../assets/style/*.* lib/",
    "deploy:prod:html": "ts-node ./debug/make-debug-pages",
    "deploy:dev:html": "ts-node ./debug/make-debug-pages dev",
    "clean": "shx rm -rf lib",
    "server": "node ./launch-server lib"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WWAWing/WWAWing.git",
    "directory": "packages/engine"
  },
  "keywords": [
    "wwa",
    "typescript"
  ],
  "author": "WWA Wing Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/WWAWing/WWAWing/issues"
  },
  "homepage": "https://github.com/WWAWing/WWAWing#readme",
  "devDependencies": {
    "@swc/core": "^1.10.4",
    "@swc/jest": "^0.2.37",
    "@types/crypto-js": "^4.1.1",
    "@types/jest": "^29.5.1",
    "@types/pug": "^2.0.6",
    "@types/terser-webpack-plugin": "^5.2.0",
    "@types/webpack": "^5.28.0",
    "@wwawing/assets": "workspace:*",
    "@wwawing/common-interface": "workspace:*",
    "@wwawing/debug-server": "workspace:*",
    "@wwawing/event-emitter": "workspace:*",
    "@wwawing/loader": "workspace:*",
    "@wwawing/page-generator": "workspace:*",
    "@wwawing/styles": "workspace:*",
    "@wwawing/virtual-pad": "workspace:*",
    "crypto-js": "^4.1.1",
    "jest": "^30.4.2",
    "jest-cli": "^30.4.2",
    "jest-environment-jsdom": "^30.4.2",
    "npm-run-all2": "^8.0.1",
    "pug": "^3.0.2",
    "shelljs": "^0.10.0",
    "shx": "^0.4.0",
    "terser-webpack-plugin": "^5.3.9",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
